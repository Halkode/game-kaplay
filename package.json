{
	"name": "myGame",
	"type": "module",
	"scripts": {
		"build": "vite build",
		"dev": "vite",
		"preview": "vite preview",
		"zip": "npm run build && mkdir -p dist && zip -r dist/game.zip dist -x \"**/.DS_Store\"",
		"test": "node --test tests/*.test.mjs",
		"art:prompt": "node scripts/art/cli.mjs prompt",
		"art:import": "node scripts/art/cli.mjs import",
		"art:walls": "node scripts/art/walls.mjs",
		"art:build": "node scripts/art/walls.mjs && node scripts/art/cli.mjs build",
		"art:check": "node scripts/art/cli.mjs check",
		"art:status": "node scripts/art/cli.mjs status",
		"art:docs": "node scripts/art/cli.mjs docs",
		"art:preview": "node scripts/art/preview.mjs"
	},
	"dependencies": {
		"kaplay": "^3001.0.19"
	},
	"devDependencies": {
		"@types/node": "^25.5.2",
		"pngjs": "^7.0.0",
		"vite": "^8.0.7"
	}
}
